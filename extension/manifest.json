{
  "manifest_version": 3,
  "name": "Audio Copyright Sentinel",
  "version": "1.4.0",
  "description": "Warns when a song from the ACPOSL public catalogue plays in your browser.",
  "permissions": ["storage", "alarms", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio Copyright Sentinel",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": ["matcher.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "audio-sentinel@copyright-sentinel.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
